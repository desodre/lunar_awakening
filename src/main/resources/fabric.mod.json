{
  "schemaVersion": 1,
  "id": "lunar_awakening",
  "version": "${version}",
  "name": "Lunar Awakening",
  "description": "Eclipses solares em horários variados do dia e luas de sangue no Overworld.",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "com.lunarawakening.LunarAwakening" }
    ],
    "client": [
      { "adapter": "kotlin", "value": "com.lunarawakening.client.LunarAwakeningClient" }
    ]
  },
  "mixins": [
    "lunar_awakening.mixins.json",
    { "config": "lunar_awakening.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.2"
  }
}
